# Wire dashboard > API key
WIRE_SECRET_KEY="sk_live_..."

# Wire dashboard > Webhook дээр endpoint үүсгэхэд нэг удаа харагдана
WIRE_WEBHOOK_SECRET="whsec_..."

# Таслалаар тусгаарласан Wire operator id (жишээ: qpay)
WIRE_ALLOWED_OPERATORS="qpay"

# Production сайтын үндсэн URL
NEXT_PUBLIC_SITE_URL="https://dead-lock-mongolia.vercel.app"

# Gmail-ийн 2 шатлалт баталгаажуулалтаар үүсгэсэн App Password
GMAIL_USER="your-account@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional: Steam Web API key. Enables resolving custom /id/vanity profile links
STEAM_API_KEY=""

# Neon Postgres — Steam login-тэй тоглогчдын профайл (Vercel дээр Neon холбоход автоматаар нэмэгдэнэ)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session cookie-д гарын үсэг зурах түлхүүр (32+ тэмдэгт). Үүсгэх:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
